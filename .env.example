# ══════════════════════════════════════════════════════════════════════════════
#  Supply Chain Intelligence OS — Environment Variables Example
#  Copy this file to .env and fill in your real values.
#  Never commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ─── DATABASE (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_USER=scuser
POSTGRES_PASSWORD=scuser
POSTGRES_DB=supply_chain
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://scuser:scuser@postgres:5432/supply_chain

# ─── CACHE (Redis) ────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── STREAMING (Kafka) ────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_AIS=ais-feed
KAFKA_TOPIC_FLIGHT=flight-feed
KAFKA_TOPIC_GEO_EVENTS=geo-events

# ─── GRAPH (Neo4j) ────────────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=admin123

# ─── AI / LLM (Required for Demand/Risk Intelligence) ─────────────────────────
# Get keys from: https://aistudio.google.com/ and https://console.groq.com/
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here

# ─── DATA APIs (Optional / Intelligence Feeds) ───────────────────────────────
NEWS_API_KEY=your_newsapi_key_here
AISSTREAM_API_KEY=your_aisstream_key_here
OPENSKY_USERNAME=your_username
OPENSKY_PASSWORD=your_password
HUNTER_API_KEY=your_hunter_io_key_here
RAPIDAPI_KEY=your_rapidapi_key_here

# ─── FRONTEND (Vite) ──────────────────────────────────────────────────────────
# Access token from https://account.mapbox.com/
VITE_MAPBOX_TOKEN=your_mapbox_token_here
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1

# ─── BACKEND SECURITY ─────────────────────────────────────────────────────────
SECRET_KEY=generate_a_random_secret_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── TELEMETRY (MLFlow) ───────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000
